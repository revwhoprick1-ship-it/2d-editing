 "lines": [
  {
   "id": "X01",
   "who": "X",
   "text": "Ken... why did you bring them here?",
   "start": 3.2,
   "end": 4.789,
   "delivery": "distorted whisper, evil",
   "speed": 1.1
  },
  {
   "id": "K01",
   "who": "K",
   "text": "Come on, guys! This is supposed to be the most dangerous forest in the country!",
   "start": 7.789,
   "end": 11.349,
   "delivery": "excited, energetic, loud",
   "speed": 1.1
  },
  {
   "id": "L01",
   "who": "L",
   "text": "Great. Exactly where I wanted to spend my weekend. In a forest where people mysteriously disappear.",
   "start": 11.549,
   "end": 16.697,
   "delivery": "sarcastic, dry, deadpan",
   "speed": 1.1
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Actually, there have been reports of missing hikers here for decades.",
   "start": 16.897,
   "end": 19.863,
   "delivery": "fast, nerdy, matter-of-fact",
   "speed": 1.1
  },
  {
   "id": "J01",
   "who": "J",
   "text": "Then why are we here?",
   "start": 20.063,
   "end": 21.057,
   "delivery": "deep, flat, annoyed",
   "speed": 1.1
  },
  {
   "id": "K02",
   "who": "K",
   "text": "Because it's an adventure!",
   "start": 21.257,
   "end": 22.341,
   "delivery": "excited, loud",
   "speed": 1.1
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Something doesn't feel right. Have you noticed that we haven't seen a single animal?",
   "start": 22.741,
   "end": 26.634,
   "delivery": "calm, observant, quiet",
   "speed": 1.1
  },
  {
   "id": "B02",
   "who": "B",
   "text": "That's... actually unusual.",
   "start": 27.634,
   "end": 29.508,
   "delivery": "uneasy, hesitant",
   "speed": 1.1
  },
  {
   "id": "K03",
   "who": "K",
   "text": "Well, obviously we're taking this one.",
   "start": 30.908,
   "end": 33.072,
   "delivery": "cocky, excited",
   "speed": 1.1
  },
  {
   "id": "L02",
   "who": "L",
   "text": "Can we please have one camping trip where we don't almost die?",
   "start": 33.272,
   "end": 36.281,
   "delivery": "sarcastic, exasperated",
   "speed": 1.1
  },
  {
   "id": "J02",
   "who": "J",
   "text": "Ken, seriously. Let's take the other path.",
   "start": 36.481,
   "end": 38.94,
   "delivery": "firm, serious",
   "speed": 1.1
  },
  {
   "id": "K04",
   "who": "K",
   "text": "Relax! It's just a sign.",
   "start": 39.14,
   "end": 40.88,
   "delivery": "dismissive, laughing",
   "speed": 1.1
  },
  {
   "id": "B03",
   "who": "B",
   "text": "Wait... these scratches look like someone was desperately trying to remove something.",
   "start": 41.38,
   "end": 44.912,
   "delivery": "nervous, fast",
   "speed": 1.1
  },
  {
   "id": "M02",
   "who": "M",
   "text": "Or trying to warn us.",
   "start": 45.112,
   "end": 46.223,
   "delivery": "quiet, serious",
   "speed": 1.1
  },
  {
   "id": "K05",
   "who": "K",
   "text": "Whoa, free Halloween decorations!",
   "start": 48.023,
   "end": 50.527,
   "delivery": "excited, joking",
   "speed": 1.1
  },
  {
   "id": "L03",
   "who": "L",
   "text": "That's a human skull, you idiot!",
   "start": 50.727,
   "end": 52.588,
   "delivery": "shouting, cracking voice",
   "speed": 1.1
  },
  {
   "id": "B04",
   "who": "B",
   "text": "These aren't animal remains. They're human.",
   "start": 52.788,
   "end": 55.011,
   "delivery": "shaky, scared",
   "speed": 1.1
  },
  {
   "id": "J03",
   "who": "J",
   "text": "Everyone stay together.",
   "start": 55.211,
   "end": 56.426,
   "delivery": "deep, protective, firm",
   "speed": 1.1
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Guys... I think something is following us.",
   "start": 59.226,
   "end": 61.509,
   "delivery": "whisper, tense",
   "speed": 1.1
  },
  {
   "id": "X02",
   "who": "X",
   "text": "Help...",
   "start": 62.709,
   "end": 63.166,
   "delivery": "weak, distant, desperate",
   "speed": 1.1
  },
  {
   "id": "K06",
   "who": "K",
   "text": "Okay... that wasn't me.",
   "start": 63.966,
   "end": 65.009,
   "delivery": "scared, quiet, nervous laugh",
   "speed": 1.1
  },
  {
   "id": "K07",
   "who": "K",
   "text": "Perfect! Shelter!",
   "start": 67.009,
   "end": 67.861,
   "delivery": "relieved, excited",
   "speed": 1.1
  },
  {
   "id": "L04",
   "who": "L",
   "text": "Of course. Because walking into a creepy abandoned house in a demonic forest is obviously safer.",
   "start": 68.061,
   "end": 73.067,
   "delivery": "sarcastic, nervous",
   "speed": 1.1
  },
  {
   "id": "J04",
   "who": "J",
   "text": "We can't stay outside all night.",
   "start": 73.267,
   "end": 74.796,
   "delivery": "firm, tired",
   "speed": 1.1
  },
  {
   "id": "M04",
   "who": "M",
   "text": "We go in together. Nobody splits up. If anything feels wrong, we leave. Immediately.",
   "start": 74.996,
   "end": 80.844,
   "delivery": "calm, clear, leader",
   "speed": 1.1
  },
  {
   "id": "B05",
   "who": "B",
   "text": "Guys...",
   "start": 83.244,
   "end": 83.937,
   "delivery": "uneasy",
   "speed": 1.1
  },
  {
   "id": "J05",
   "who": "J",
   "text": "What?",
   "start": 84.137,
   "end": 84.502,
   "delivery": "sharp",
   "speed": 1.1
  },
  {
   "id": "B06",
   "who": "B",
   "text": "Someone set this table. For five.",
   "start": 84.702,
   "end": 86.595,
   "delivery": "scared whisper",
   "speed": 1.1
  },
  {
   "id": "K08",
   "who": "K",
   "text": "Maybe we have a ghost butler.",
   "start": 86.895,
   "end": 88.445,
   "delivery": "joking, nervous laugh",
   "speed": 1.1
  },
  {
   "id": "L05",
   "who": "L",
   "text": "Please. Stop. Talking.",
   "start": 88.645,
   "end": 90.3,
   "delivery": "annoyed, scared",
   "speed": 1.1
  },
  {
   "id": "X03",
   "who": "X",
   "text": "Guys? Open the door.",
   "start": 93.7,
   "end": 95.346,
   "delivery": "calm, muffled, from outside",
   "speed": 1.1
  },
  {
   "id": "M05",
   "who": "M",
   "text": "Nobody open that door.",
   "start": 95.946,
   "end": 97.162,
   "delivery": "urgent whisper",
   "speed": 1.1
  },
  {
   "id": "K09",
   "who": "K",
   "text": "Wait... if you're in here... then who's outside?",
   "start": 97.462,
   "end": 100.635,
   "delivery": "scared, confused",
   "speed": 1.1
  },
  {
   "id": "X04",
   "who": "X",
   "text": "Guys, please. It's cold.",
   "start": 101.235,
   "end": 103.049,
   "delivery": "pleading, muffled, from outside",
   "speed": 1.1
  },
  {
   "id": "J06",
   "who": "J",
   "text": "That's not me.",
   "start": 103.649,
   "end": 104.536,
   "delivery": "deep, scared, quiet",
   "speed": 1.1
  },
  {
   "id": "B07",
   "who": "B",
   "text": "Whatever is out there... it's copying our voices.",
   "start": 104.836,
   "end": 106.995,
   "delivery": "panicked, shaky",
   "speed": 1.1
  },
  {
   "id": "L06",
   "who": "L",
   "text": "Okay. New plan. We leave. Right now.",
   "start": 107.195,
   "end": 109.767,
   "delivery": "panicked, voice cracking",
   "speed": 1.1
  },
  {
   "id": "X05",
   "who": "X",
   "text": "Why are you all leaving?",
   "start": 113.967,
   "end": 115.05,
   "delivery": "calm, wrong, distorted",
   "speed": 1.1
  },
  {
   "id": "K10",
   "who": "K",
   "text": "What the hell is that?!",
   "start": 115.45,
   "end": 116.541,
   "delivery": "screaming, terrified",
   "speed": 1.1
  },
  {
   "id": "J07",
   "who": "J",
   "text": "Run! Run!",
   "start": 117.641,
   "end": 119.421,
   "delivery": "shouting, desperate",
   "speed": 1.1
  },
  {
   "id": "L07",
   "who": "L",
   "text": "I told you! I literally told you!",
   "start": 119.521,
   "end": 121.446,
   "delivery": "screaming, panicked",
   "speed": 1.1
  },
  {
   "id": "B08",
   "who": "B",
   "text": "It's coming!",
   "start": 121.546,
   "end": 122.108,
   "delivery": "screaming, terrified",
   "speed": 1.1
  },
  {
   "id": "M06",
   "who": "M",
   "text": "There! The door!",
   "start": 122.308,
   "end": 123.391,
   "delivery": "shouting, urgent",
   "speed": 1.1
  },
  {
   "id": "L08",
   "who": "L",
   "text": "Okay... never again. Never again.",
   "start": 130.191,
   "end": 132.608,
   "delivery": "exhausted, out of breath",
   "speed": 1.1
  },
  {
   "id": "J08",
   "who": "J",
   "text": "Is everyone here?",
   "start": 132.908,
   "end": 133.868,
   "delivery": "out of breath, protective",
   "speed": 1.1
  },
  {
   "id": "B09",
   "who": "B",
   "text": "One... two... three... four... five.",
   "start": 134.068,
   "end": 136.796,
   "delivery": "counting, out of breath",
   "speed": 1.1
  },
  {
   "id": "K11",
   "who": "K",
   "text": "Guys... that was actually kind of fun.",
   "start": 137.396,
   "end": 139.488,
   "delivery": "laughing, excited",
   "speed": 1.1
  },
  {
   "id": "M07",
   "who": "M",
   "text": "Guys...",
   "start": 141.088,
   "end": 141.621,
   "delivery": "quiet, scared",
   "speed": 1.1
  },
  {
   "id": "B10",
   "who": "B",
   "text": "What?",
   "start": 141.921,
   "end": 142.284,
   "delivery": "nervous",
   "speed": 1.1
  },
  {
   "id": "M08",
   "who": "M",
   "text": "Don't move.",
   "start": 142.584,
   "end": 143.265,
   "delivery": "whisper, terrified",
   "speed": 1.1
  },
  {
   "id": "K12",
   "who": "K",
   "text": "You forgot something.",
   "start": 145.065,
   "end": 146.062,
   "delivery": "calm, wrong, smiling",
   "speed": 1.1
  },
  {
   "id": "X06",
   "who": "X",
   "text": "One of us is still inside.",
   "start": 147.862,
   "end": 149.331,
   "delivery": "whisper, evil",
   "speed": 1.1
  }
 ],
