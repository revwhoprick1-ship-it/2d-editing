{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "O01",
   "who": "O",
   "text": "Sweetie. What did I say about the basement?",
   "start": 0.0,
   "end": 2.579,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N01",
   "who": "N",
   "text": "My mom died two years ago. So who's been making my breakfast?",
   "start": 3.079,
   "end": 7.843,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "Since the accident, every morning is the same. Same song. Same smile.",
   "start": 8.243,
   "end": 14.298,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O02",
   "who": "O",
   "text": "Eat up, sweetie.",
   "start": 14.498,
   "end": 15.467,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "I can't remember the crash. Just her voice, saying something I can't hear.",
   "start": 15.867,
   "end": 21.42,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "Q01",
   "who": "Q",
   "text": "If I don't come back... it's not...",
   "start": 21.62,
   "end": 23.63,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Mom... what did you say to me in the car?",
   "start": 24.13,
   "end": 26.606,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O03",
   "who": "O",
   "text": "I said I love you.",
   "start": 26.906,
   "end": 27.879,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "That night, something knocked. From under the floor.",
   "start": 28.479,
   "end": 32.305,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P01",
   "who": "P",
   "text": "Sweetie? Is she asleep?",
   "start": 32.605,
   "end": 34.356,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M02",
   "who": "M",
   "text": "Mom?",
   "start": 34.656,
   "end": 35.109,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P02",
   "who": "P",
   "text": "Don't let her hear you. Come down.",
   "start": 35.409,
   "end": 37.513,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Twelve steps to the basement. Tonight, there were thirteen.",
   "start": 38.013,
   "end": 42.95,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P03",
   "who": "P",
   "text": "She put me down here two years ago.",
   "start": 43.55,
   "end": 45.565,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O04",
   "who": "O",
   "text": "Sweetie. That isn't me.",
   "start": 45.965,
   "end": 47.837,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P04",
   "who": "P",
   "text": "Remember the car. Remember what I told you.",
   "start": 48.137,
   "end": 50.698,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O05",
   "who": "O",
   "text": "Remember what I told you, sweetie.",
   "start": 50.898,
   "end": 52.336,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "One of them is my mom. The other one crawled out of that car.",
   "start": 52.836,
   "end": 57.513,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "So which one is real? One, the mom in the basement. Two, the mom on the stairs. Or three... I run.",
   "start": 57.913,
   "end": 67.651,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Comment your pick. One hidden detail gives it away.",
   "start": 67.951,
   "end": 71.945,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Pick me.",
   "start": 72.245,
   "end": 72.791,
   "delivery": "",
   "speed": 1.06
  }
 ],
