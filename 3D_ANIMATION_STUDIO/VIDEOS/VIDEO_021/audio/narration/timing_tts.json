{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "O01",
   "who": "O",
   "text": "Sweetie. What did I say about the basement?",
   "start": 0.35,
   "end": 1.639,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N01",
   "who": "N",
   "text": "My mom died two years ago. So who's been making my breakfast?",
   "start": 1.939,
   "end": 6.704,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "Since the accident, every morning is the same. Same song. Same smile.",
   "start": 6.944,
   "end": 12.998,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O02",
   "who": "O",
   "text": "Eat up, sweetie.",
   "start": 13.118,
   "end": 14.088,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "I can't remember the crash. Just her voice, saying something I can't hear.",
   "start": 14.528,
   "end": 20.081,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "Q01",
   "who": "Q",
   "text": "If I don't come back... it's not...",
   "start": 20.2,
   "end": 21.206,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Mom... what did you say to me in the car?",
   "start": 21.806,
   "end": 24.282,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O03",
   "who": "O",
   "text": "I said I love you.",
   "start": 24.462,
   "end": 25.434,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "That night, something knocked. From under the floor.",
   "start": 26.194,
   "end": 30.021,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P01",
   "who": "P",
   "text": "Sweetie? Is she asleep?",
   "start": 31.351,
   "end": 32.226,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M02",
   "who": "M",
   "text": "Mom?",
   "start": 32.406,
   "end": 32.859,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P02",
   "who": "P",
   "text": "Don't let her hear you. Come down.",
   "start": 33.039,
   "end": 34.091,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Twelve steps to the basement. Tonight, there were thirteen.",
   "start": 34.891,
   "end": 39.828,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P03",
   "who": "P",
   "text": "She put me down here two years ago.",
   "start": 40.938,
   "end": 41.945,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O04",
   "who": "O",
   "text": "Sweetie. That isn't me.",
   "start": 42.585,
   "end": 43.521,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P04",
   "who": "P",
   "text": "Remember the car. Remember what I told you.",
   "start": 43.701,
   "end": 44.982,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O05",
   "who": "O",
   "text": "Remember what I told you, sweetie.",
   "start": 45.102,
   "end": 45.821,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "One of them is my mom. The other one crawled out of that car.",
   "start": 46.121,
   "end": 50.798,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "So which one is real? One, the mom in the basement. Two, the mom on the stairs. Or three... I run.",
   "start": 51.338,
   "end": 61.076,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Comment your pick. One hidden detail gives it away.",
   "start": 62.056,
   "end": 66.05,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Pick me.",
   "start": 66.63,
   "end": 66.916,
   "delivery": "",
   "speed": 1.06
  }
 ],
