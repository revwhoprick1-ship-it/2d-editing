{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "O01",
   "who": "O",
   "text": "Sweetie. What did I say about the basement?",
   "start": 0.35,
   "end": 2.929,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N01",
   "who": "N",
   "text": "My mom died two years ago. So who's been making my breakfast?",
   "start": 3.229,
   "end": 7.993,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "Since the accident, every morning is the same. Same song. Same smile.",
   "start": 8.233,
   "end": 14.288,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O02",
   "who": "O",
   "text": "Eat up, sweetie.",
   "start": 14.408,
   "end": 15.377,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "I can't remember the crash. Just her voice, saying something I can't hear.",
   "start": 15.817,
   "end": 21.37,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "Q01",
   "who": "Q",
   "text": "If I don't come back... it's not...",
   "start": 21.49,
   "end": 23.5,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Mom... what did you say to me in the car?",
   "start": 24.1,
   "end": 26.576,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O03",
   "who": "O",
   "text": "I said I love you.",
   "start": 26.756,
   "end": 27.729,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "That night, something knocked. From under the floor.",
   "start": 28.489,
   "end": 32.316,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P01",
   "who": "P",
   "text": "Sweetie? Is she asleep?",
   "start": 33.645,
   "end": 35.396,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M02",
   "who": "M",
   "text": "Mom?",
   "start": 35.576,
   "end": 36.029,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P02",
   "who": "P",
   "text": "Don't let her hear you. Come down.",
   "start": 36.209,
   "end": 38.313,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Twelve steps to the basement. Tonight, there were thirteen.",
   "start": 39.113,
   "end": 44.05,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P03",
   "who": "P",
   "text": "She put me down here two years ago.",
   "start": 45.16,
   "end": 47.175,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O04",
   "who": "O",
   "text": "Sweetie. That isn't me.",
   "start": 47.815,
   "end": 49.687,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "P04",
   "who": "P",
   "text": "Remember the car. Remember what I told you.",
   "start": 49.867,
   "end": 52.428,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O05",
   "who": "O",
   "text": "Remember what I told you, sweetie.",
   "start": 52.548,
   "end": 53.986,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "One of them is my mom. The other one crawled out of that car.",
   "start": 54.286,
   "end": 58.963,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Pick me.",
   "start": 61.803,
   "end": 62.349,
   "delivery": "",
   "speed": 1.06
  }
 ],
