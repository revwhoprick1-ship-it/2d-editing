 "lines": [
  {
   "id": "L01",
   "text": "Eight billion people just farted. At the exact same second!",
   "start": 0.0,
   "end": 3.325,
   "delivery": "hook",
   "speed": 1.04
  },
  {
   "id": "L02",
   "text": "In elevators. On live TV. In the middle of a wedding kiss!",
   "start": 3.505,
   "end": 6.867,
   "delivery": "excited",
   "speed": 1.12
  },
  {
   "id": "L03",
   "text": "Scientists said: relax, farting is normal.",
   "start": 7.018,
   "end": 9.665,
   "delivery": "calm",
   "speed": 1.06
  },
  {
   "id": "L04",
   "text": "The smell is just a tiny bit of sulfur gas.",
   "start": 9.715,
   "end": 12.162,
   "delivery": "calm",
   "speed": 1.06
  },
  {
   "id": "L05",
   "text": "Tiny.",
   "start": 12.712,
   "end": 13.353,
   "delivery": "humor",
   "speed": 0.9
  },
  {
   "id": "L06",
   "text": "So the whole planet asked one question: who farted first?",
   "start": 14.253,
   "end": 17.368,
   "delivery": "dramatic",
   "speed": 1.08
  },
  {
   "id": "L07",
   "text": "Security footage. Enhance. Enhance. Enhance!",
   "start": 17.488,
   "end": 20.376,
   "delivery": "urgent",
   "speed": 1.05
  },
  {
   "id": "L08",
   "text": "One elevator. One guy.",
   "start": 20.476,
   "end": 22.155,
   "delivery": "dramatic",
   "speed": 1.0
  },
  {
   "id": "L09",
   "text": "He blamed grandma. Grandma blamed the businessman. The businessman blamed the kid.",
   "start": 22.505,
   "end": 27.243,
   "delivery": "excited",
   "speed": 1.16
  },
  {
   "id": "L10",
   "text": "And the kid... blamed him.",
   "start": 27.343,
   "end": 28.838,
   "delivery": "humor",
   "speed": 1.0
  },
  {
   "id": "L11",
   "text": "Farts aren't contagious.",
   "start": 29.338,
   "end": 30.605,
   "delivery": "calm",
   "speed": 0.98
  },
  {
   "id": "L12",
   "text": "But this one?",
   "start": 31.055,
   "end": 31.915,
   "delivery": "suspense",
   "speed": 0.92
  },
  {
   "id": "L13",
   "text": "It all started... with one tiny...",
   "start": 33.065,
   "end": 35.033,
   "delivery": "suspense",
   "speed": 0.95
  }
 ],
