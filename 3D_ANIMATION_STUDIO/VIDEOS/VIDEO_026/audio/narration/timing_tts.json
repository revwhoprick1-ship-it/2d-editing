 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Bob texted: Don't open the door... while sitting next to you.",
   "start": 0.0,
   "end": 4.172,
   "exact": true
  },
  {
   "id": "N03",
   "who": "N",
   "text": "For the last twenty minutes.",
   "start": 4.372,
   "end": 6.453,
   "exact": true
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Then he sends a photo... of your living room.",
   "start": 6.653,
   "end": 9.11,
   "exact": true
  },
  {
   "id": "N05",
   "who": "N",
   "text": "In the photo, it isn't watching the TV.",
   "start": 9.31,
   "end": 11.6,
   "exact": true
  },
  {
   "id": "N06",
   "who": "N",
   "text": "It's staring at your throat.",
   "start": 11.8,
   "end": 13.932,
   "exact": true
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Bob... did you just text me?",
   "start": 14.132,
   "end": 15.802,
   "exact": true
  },
  {
   "id": "N07",
   "who": "N",
   "text": "His lips don't move. His throat does.",
   "start": 16.002,
   "end": 18.572,
   "exact": true
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Let me in, I'm freezing!",
   "start": 18.772,
   "end": 20.38,
   "exact": true
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Then someone pounds on the front door.",
   "start": 20.58,
   "end": 22.783,
   "exact": true
  },
  {
   "id": "N09",
   "who": "N",
   "text": "The real Bob. He holds up his phone.",
   "start": 22.983,
   "end": 25.65,
   "exact": true
  },
  {
   "id": "N10",
   "who": "N",
   "text": "Hold your breath. It hunts by sound.",
   "start": 25.85,
   "end": 28.628,
   "exact": true
  },
  {
   "id": "N11",
   "who": "N",
   "text": "The TV switches to your security feed.",
   "start": 28.828,
   "end": 31.075,
   "exact": true
  },
  {
   "id": "N12",
   "who": "N",
   "text": "On screen, it climbs over the couch.",
   "start": 31.275,
   "end": 33.57,
   "exact": true
  },
  {
   "id": "N13",
   "who": "N",
   "text": "Then you see the corner: five-second delay.",
   "start": 33.77,
   "end": 36.554,
   "exact": false
  },
  {
   "id": "N14",
   "who": "N",
   "text": "It's already behind you.",
   "start": 36.754,
   "end": 38.517,
   "exact": true
  },
  {
   "id": "N15",
   "who": "N",
   "text": "You hold your breath.",
   "start": 38.717,
   "end": 40.502,
   "exact": true
  },
  {
   "id": "N16",
   "who": "N",
   "text": "So it calls your phone.",
   "start": 40.702,
   "end": 43.112,
   "exact": true
  },
  {
   "id": "N17",
   "who": "N",
   "text": "It rises behind you. Bob's face splits.",
   "start": 43.312,
   "end": 47.604,
   "exact": true
  },
  {
   "id": "N18",
   "who": "N",
   "text": "Straight down the middle.",
   "start": 47.804,
   "end": 49.397,
   "exact": true
  },
  {
   "id": "D01",
   "who": "B",
   "text": "He told you not to open the door... so now you're locked in here with me.",
   "start": 49.597,
   "end": 53.076,
   "exact": true
  },
  {
   "id": "N19",
   "who": "N",
   "text": "The real Bob just kicked the door open.",
   "start": 53.276,
   "end": 55.985,
   "exact": true
  },
  {
   "id": "N20",
   "who": "N",
   "text": "Smash, hide, or run? Comment now.",
   "start": 56.185,
   "end": 60.31,
   "exact": true
  }
 ],
