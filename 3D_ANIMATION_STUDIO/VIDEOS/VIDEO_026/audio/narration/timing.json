 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Bob texted: Don't open the door... while sitting next to you.",
   "start": 0.1,
   "end": 3.123,
   "exact": true,
   "tempo": 1.38
  },
  {
   "id": "N03",
   "who": "N",
   "text": "For the last twenty minutes.",
   "start": 3.15,
   "end": 4.75,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Then he sends a photo... of your living room.",
   "start": 4.95,
   "end": 7.087,
   "exact": true,
   "tempo": 1.15
  },
  {
   "id": "N05",
   "who": "N",
   "text": "In the photo, it isn't watching the TV.",
   "start": 8.1,
   "end": 9.992,
   "exact": true,
   "tempo": 1.21
  },
  {
   "id": "N06",
   "who": "N",
   "text": "It's staring at your throat.",
   "start": 10.05,
   "end": 11.756,
   "exact": true,
   "tempo": 1.25
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Bob... did you just text me?",
   "start": 11.9,
   "end": 13.569,
   "exact": true,
   "tempo": 1.0
  },
  {
   "id": "N07",
   "who": "N",
   "text": "His lips don't move. His throat does.",
   "start": 13.905,
   "end": 15.882,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Let me in, I'm freezing!",
   "start": 15.86,
   "end": 17.718,
   "exact": true,
   "tempo": 1.0
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Then someone pounds on the front door.",
   "start": 18.5,
   "end": 20.416,
   "exact": true,
   "tempo": 1.15
  },
  {
   "id": "N09",
   "who": "N",
   "text": "The real Bob. He holds up his phone.",
   "start": 22.7,
   "end": 24.751,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "N10",
   "who": "N",
   "text": "Hold your breath. It hunts by sound.",
   "start": 24.85,
   "end": 26.987,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "N11",
   "who": "N",
   "text": "The TV switches to your security feed.",
   "start": 27.2,
   "end": 28.928,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "N12",
   "who": "N",
   "text": "On screen, it climbs over the couch.",
   "start": 29.2,
   "end": 31.112,
   "exact": true,
   "tempo": 1.2
  },
  {
   "id": "N13",
   "who": "N",
   "text": "Then you see the corner: five-second delay.",
   "start": 31.7,
   "end": 33.927,
   "exact": false,
   "tempo": 1.25
  },
  {
   "id": "N14",
   "who": "N",
   "text": "It's already behind you.",
   "start": 34.5,
   "end": 36.102,
   "exact": true,
   "tempo": 1.1
  },
  {
   "id": "N15",
   "who": "N",
   "text": "You hold your breath.",
   "start": 36.75,
   "end": 38.238,
   "exact": true,
   "tempo": 1.2
  },
  {
   "id": "N16",
   "who": "N",
   "text": "So it calls your phone.",
   "start": 38.5,
   "end": 40.508,
   "exact": true,
   "tempo": 1.2
  },
  {
   "id": "N17",
   "who": "N",
   "text": "It rises behind you. Bob's face splits.",
   "start": 40.577,
   "end": 43.878,
   "exact": true,
   "tempo": 1.3
  },
  {
   "id": "N18",
   "who": "N",
   "text": "Straight down the middle.",
   "start": 44.15,
   "end": 45.598,
   "exact": true,
   "tempo": 1.1
  },
  {
   "id": "D01",
   "who": "B",
   "text": "He told you not to open the door... so now you're locked in here with me.",
   "start": 46.3,
   "end": 50.254,
   "exact": true,
   "tempo": 1.0
  },
  {
   "id": "N19",
   "who": "N",
   "text": "The real Bob just kicked the door open.",
   "start": 50.8,
   "end": 52.821,
   "exact": true,
   "tempo": 1.34
  },
  {
   "id": "N20",
