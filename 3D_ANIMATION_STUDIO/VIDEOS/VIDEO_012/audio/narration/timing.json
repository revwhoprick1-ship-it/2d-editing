 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Grandma had one rule. Never touch the vase.",
   "start": 0.0,
   "end": 2.117,
   "delivery": "low, ominous",
   "speed": 1.07
  },
  {
   "id": "N02",
   "who": "N",
   "text": "You just broke it.",
   "start": 2.317,
   "end": 3.005,
   "delivery": "sudden, dread",
   "speed": 1.07
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Something black crawls out of the pieces... and slides into the walls.",
   "start": 3.405,
   "end": 6.565,
   "delivery": "creeping",
   "speed": 1.07
  },
  {
   "id": "N04",
   "who": "N",
   "text": "At dinner, everything seems normal.",
   "start": 6.865,
   "end": 8.614,
   "delivery": "calm",
   "speed": 1.07
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Until you notice Mom hasn't blinked. Not once.",
   "start": 8.814,
   "end": 11.468,
   "delivery": "creeping",
   "speed": 1.07
  },
  {
   "id": "N06",
   "who": "N",
   "text": "Your little sister is chewing... but her plate is empty.",
   "start": 11.768,
   "end": 13.993,
   "delivery": "dread",
   "speed": 1.07
  },
  {
   "id": "N07",
   "who": "N",
   "text": "Then Dad slowly looks up at you.",
   "start": 14.293,
   "end": 15.951,
   "delivery": "slow, quiet",
   "speed": 1.07
  },
  {
   "id": "D1",
   "who": "DAD",
   "text": "Why did you let it out?",
   "start": 16.551,
   "end": 17.617,
   "delivery": "flat, cold",
   "speed": 1.07
  },
  {
   "id": "N08",
   "who": "N",
   "text": "You blink. And they're all just eating. Like nothing happened.",
   "start": 18.017,
   "end": 21.2,
   "delivery": "shaky",
   "speed": 1.07
  },
  {
   "id": "N09",
   "who": "N",
   "text": "That night, the power goes out.",
   "start": 21.6,
   "end": 23.1,
   "delivery": "low",
   "speed": 1.07
  },
  {
   "id": "N10",
   "who": "N",
   "text": "The house is pitch black. And your phone is at four percent.",
   "start": 23.7,
   "end": 26.242,
   "delivery": "tense",
   "speed": 1.07
  },
  {
   "id": "N11",
   "who": "N",
   "text": "Then you hear Mom, calling from downstairs.",
   "start": 26.542,
   "end": 28.584,
   "delivery": "quiet",
   "speed": 1.07
  },
  {
   "id": "D2",
   "who": "MOM",
   "text": "Sweetie? Come downstairs. I want to show you something.",
   "start": 28.884,
   "end": 31.424,
   "delivery": "sweet, too calm",
   "speed": 1.07
  },
  {
   "id": "N12",
   "who": "N",
   "text": "But Mom's car isn't in the driveway. She's still at work.",
   "start": 31.924,
   "end": 34.304,
   "delivery": "dread, slow",
   "speed": 1.07
  },
  {
   "id": "N13",
   "who": "N",
   "text": "Something is coming up the stairs. On all fours.",
   "start": 34.804,
   "end": 37.497,
   "delivery": "whisper, terror",
   "speed": 1.07
  },
  {
   "id": "N14",
   "who": "N",
   "text": "You lock yourself in the bathroom.",
   "start": 37.797,
   "end": 39.204,
   "delivery": "fast",
   "speed": 1.07
  },
  {
   "id": "N15",
   "who": "N",
   "text": "It stops right outside the door. And then... nothing.",
   "start": 39.504,
   "end": 42.533,
   "delivery": "whisper",
   "speed": 1.07
  },
  {
   "id": "N16",
   "who": "N",
   "text": "You look up at the mirror.",
   "start": 43.933,
   "end": 44.972,
   "delivery": "whisper",
   "speed": 1.07
  },
  {
   "id": "N17",
   "who": "N",
   "text": "Your phone dies.",
   "start": 46.172,
   "end": 46.94,
   "delivery": "flat",
   "speed": 1.07
  },
  {
   "id": "N18",
   "who": "N",
   "text": "And in the dark, something whispers right next to your ear.",
   "start": 47.94,
   "end": 50.04,
   "delivery": "whisper, terror",
   "speed": 1.07
  },
  {
   "id": "D3",
   "who": "DEM",
   "text": "You broke my home. Now I live in yours.",
   "start": 50.34,
   "end": 53.601,
   "delivery": "whisper, evil",
   "speed": 1.07
  },
  {
   "id": "N19",
   "who": "N",
   "text": "The pieces are still on your floor. Glue the vase back together. Burn the pieces. Or run to Grandma's house.",
   "start": 54.201,
   "end": 59.746,
   "delivery": "urgent",
   "speed": 1.07
  },
  {
   "id": "N20",
   "who": "N",
   "text": "Comment one, two, or three. If you survive... there's a part two.",
   "start": 60.046,
   "end": 63.058,
   "delivery": "low, final",
   "speed": 1.07
  }
 ],
