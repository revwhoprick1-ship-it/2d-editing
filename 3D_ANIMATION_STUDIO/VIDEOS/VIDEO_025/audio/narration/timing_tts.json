{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "At eleven fifty-nine, every phone on Earth screamed.",
   "start": 0.0,
   "end": 4.045,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "A01",
   "who": "A",
   "text": "The world ends in sixty seconds. This is not a test.",
   "start": 4.245,
   "end": 7.444,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N02",
   "who": "N",
   "text": "My little sister was home alone. Three blocks away.",
   "start": 7.644,
   "end": 11.671,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Fifty seconds. I ran.",
   "start": 11.871,
   "end": 14.308,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Then gravity... blinked.",
   "start": 14.508,
   "end": 16.947,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "P01",
   "who": "P",
   "text": "Are you with Mia?",
   "start": 17.147,
   "end": 18.19,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Almost!",
   "start": 18.39,
   "end": 19.675,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "P02",
   "who": "P",
   "text": "Don't let go of her hand. Promise me.",
   "start": 19.875,
   "end": 22.153,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "M02",
   "who": "M",
   "text": "I promise.",
   "start": 22.353,
   "end": 23.221,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Then the lights came down. They were looking for someone.",
   "start": 23.421,
   "end": 27.669,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "S01",
   "who": "S",
   "text": "I knew you'd come.",
   "start": 27.869,
   "end": 29.558,
   "delivery": "",
   "speed": 1.0
  },
  {
   "id": "N06",
   "who": "N",
   "text": "I held her hand. I didn't let go.",
   "start": 29.758,
   "end": 33.341,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "A02",
   "who": "A",
   "text": "Selection complete. One human will be kept.",
   "start": 33.541,
   "end": 36.706,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N07",
   "who": "N",
   "text": "It picked me.",
   "start": 36.906,
   "end": 38.278,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "S02",
   "who": "S",
   "text": "It picked you...",
   "start": 38.478,
   "end": 39.822,
   "delivery": "",
   "speed": 1.0
  },
  {
   "id": "S03",
   "who": "S",
   "text": "It's okay. Go.",
   "start": 40.022,
   "end": 41.712,
   "delivery": "",
   "speed": 1.0
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Not without you!",
   "start": 41.912,
   "end": 43.434,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "S04",
   "who": "S",
   "text": "Does it hurt... when the world ends?",
   "start": 43.634,
   "end": 46.392,
   "delivery": "",
   "speed": 1.0
  },
  {
   "id": "N08",
   "who": "N",
   "text": "The light only takes one.",
   "start": 46.592,
   "end": 48.959,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N09",
   "who": "N",
   "text": "I could go. I could give it to her. Or I could stay.",
   "start": 49.159,
   "end": 53.499,
   "delivery": "",
   "speed": 1.05
  },
  {
   "id": "N10",
   "who": "N",
   "text": "One, two, or three. Choose.",
   "start": 53.699,
   "end": 56.826,
   "delivery": "",
   "speed": 1.05
  }
 ],
