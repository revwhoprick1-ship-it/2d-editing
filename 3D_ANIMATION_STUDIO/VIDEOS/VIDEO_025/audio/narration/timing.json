{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "At eleven fifty-nine, every phone on Earth screamed.",
   "start": 0.15,
   "end": 3.262,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.3
  },
  {
   "id": "A01",
   "who": "A",
   "text": "The world ends in sixty seconds. This is not a test.",
   "start": 3.4,
   "end": 6.689,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.079
  },
  {
   "id": "N02",
   "who": "N",
   "text": "My little sister was home alone. Three blocks away.",
   "start": 6.75,
   "end": 10.106,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.2
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Fifty seconds. I ran.",
   "start": 10.2,
   "end": 12.23,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.2
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Then gravity... blinked.",
   "start": 12.35,
   "end": 14.567,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.1
  },
  {
   "id": "P01",
   "who": "P",
   "text": "Are you with Mia?",
   "start": 17.3,
   "end": 18.34,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.099
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Almost!",
   "start": 18.4,
   "end": 19.471,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.2
  },
  {
   "id": "P02",
   "who": "P",
   "text": "Don't let go of her hand. Promise me.",
   "start": 19.55,
   "end": 21.841,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.038
  },
  {
   "id": "M02",
   "who": "M",
   "text": "I promise.",
   "start": 21.9,
   "end": 22.768,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.0
  },
  {
   "id": "N05",
   "who": "N",
   "text": "Then the lights came down. They were looking for someone.",
   "start": 23.6,
   "end": 27.463,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.1
  },
  {
   "id": "S01",
   "who": "S",
   "text": "I knew you'd come.",
   "start": 29.5,
   "end": 31.189,
   "delivery": "",
   "speed": 1.0,
   "tempo": 1.0
  },
  {
   "id": "N06",
   "who": "N",
   "text": "I held her hand. I didn't let go.",
   "start": 31.4,
   "end": 34.658,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.1
  },
  {
   "id": "A02",
   "who": "A",
   "text": "Selection complete. One human will be kept.",
   "start": 36.8,
   "end": 40.314,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.0
  },
  {
   "id": "N07",
   "who": "N",
   "text": "It picked me.",
   "start": 41.1,
   "end": 42.473,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.0
  },
  {
   "id": "S02",
   "who": "S",
   "text": "It picked you...",
   "start": 42.55,
   "end": 43.893,
   "delivery": "",
   "speed": 1.0,
   "tempo": 1.0
  },
  {
   "id": "S03",
   "who": "S",
   "text": "It's okay. Go.",
   "start": 44.0,
   "end": 45.69,
   "delivery": "",
   "speed": 1.0,
   "tempo": 1.0
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Not without you!",
   "start": 45.8,
   "end": 47.322,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.0
  },
  {
   "id": "S04",
   "who": "S",
   "text": "Does it hurt... when the world ends?",
   "start": 47.45,
   "end": 50.208,
   "delivery": "",
   "speed": 1.0,
   "tempo": 1.0
  },
  {
   "id": "N08",
   "who": "N",
   "text": "The light only takes one.",
   "start": 50.45,
   "end": 52.817,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.0
  },
  {
   "id": "N09",
   "who": "N",
   "text": "I could go. I could give it to her. Or I could stay.",
   "start": 53.0,
   "end": 56.945,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.1
  },
  {
   "id": "N10",
   "who": "N",
   "text": "One, two, or three. Choose.",
   "start": 57.1,
   "end": 59.59,
   "delivery": "",
   "speed": 1.05,
   "tempo": 1.256
  }
 ],
