 "lines": [
  {
   "id": "L01",
   "text": "Every drug on Earth just became legal.",
   "start": 0.0,
   "end": 2.06,
   "delivery": "hook",
   "speed": 1.12
  },
  {
   "id": "L02",
   "text": "Your grandma didn't even notice.",
   "start": 2.21,
   "end": 3.487,
   "delivery": "deadpan",
   "speed": 1.12
  },
  {
   "id": "L03",
   "text": "She's already on fourteen prescriptions.",
   "start": 3.587,
   "end": 5.452,
   "delivery": "punchline",
   "speed": 1.12
  },
  {
   "id": "L04",
   "text": "Drug dealers? Unemployed overnight.",
   "start": 5.802,
   "end": 8.012,
   "delivery": "news",
   "speed": 1.12
  },
  {
   "id": "L05",
   "text": "This guy just changed his LinkedIn to freelance pharmacist.",
   "start": 8.112,
   "end": 10.928,
   "delivery": "comic",
   "speed": 1.12
  },
  {
   "id": "L06",
   "text": "And the cartels went bankrupt and started a podcast.",
   "start": 11.128,
   "end": 14.373,
   "delivery": "comic",
   "speed": 1.12
  },
  {
   "id": "L07",
   "text": "But here's the twist.",
   "start": 14.773,
   "end": 15.741,
   "delivery": "suspense",
   "speed": 1.12
  },
  {
   "id": "L08",
   "text": "Portugal decriminalized every drug back in 2001.",
   "start": 15.841,
   "end": 18.728,
   "delivery": "fact",
   "speed": 1.12
  },
  {
   "id": "L09",
   "text": "Drug deaths went down. Nobody turned into a zombie.",
   "start": 18.828,
   "end": 21.247,
   "delivery": "fact",
   "speed": 1.12
  },
  {
   "id": "L10",
   "text": "Still, legal doesn't mean safe. Cigarettes are legal. Ask your lungs.",
   "start": 21.547,
   "end": 25.076,
   "delivery": "warning",
   "speed": 1.12
  },
  {
   "id": "L11",
   "text": "So what's the most addictive thing left on Earth?",
   "start": 25.376,
   "end": 27.525,
   "delivery": "question",
   "speed": 1.12
  },
  {
   "id": "L12",
   "text": "It's legal. It's free. And it's in your hand right now.",
   "start": 27.775,
   "end": 30.648,
   "delivery": "reveal",
   "speed": 1.12
  },
  {
   "id": "L13",
   "text": "That's why you're about to watch this again.",
   "start": 30.848,
   "end": 32.63,
   "delivery": "loop",
   "speed": 1.12
  }
 ],
