{
 "voice": "chatterbox+kokoro:am_fenrir",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "You blinked. And everyone on this bus... is gone.",
   "start": 0.0,
   "end": 2.567,
   "delivery": "sudden, low",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "Their phones are still on the seats. Still lit up. Still warm.",
   "start": 3.067,
   "end": 6.315,
   "delivery": "creeping",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "One of them is still recording. You pick it up and press play.",
   "start": 6.615,
   "end": 9.53,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "One minute ago. Everyone is here. Then, all at the same time... they turn around and look at you.",
   "start": 9.93,
   "end": 14.683,
   "delivery": "dread, slow",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "And the video ends.",
   "start": 14.983,
   "end": 16.272,
   "delivery": "flat, ominous",
   "speed": 1.06
  },
  {
   "id": "D1",
   "who": "M",
   "text": "Hey! Driver! Where did everyone go?",
   "start": 16.772,
   "end": 18.186,
   "delivery": "panic",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "The driver doesn't turn around.",
   "start": 18.486,
   "end": 19.796,
   "delivery": "low",
   "speed": 1.06
  },
  {
   "id": "D2",
   "who": "DR",
   "text": "They got off at their stop.",
   "start": 19.996,
   "end": 21.315,
   "delivery": "calm, deep, slow",
   "speed": 0.9
  },
  {
   "id": "D3",
   "who": "M",
   "text": "We haven't stopped once!",
   "start": 21.715,
   "end": 23.195,
   "delivery": "panic, angry",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "You look up at the route screen. The next stop isn't a street. It just says... you.",
   "start": 23.595,
   "end": 27.213,
   "delivery": "dread",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Outside, the city is gone. There's only fog... and faces in the fog.",
   "start": 27.713,
   "end": 31.157,
   "delivery": "whisper, scary",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "It's them. Every passenger. Standing perfectly still. Waving goodbye.",
   "start": 31.457,
   "end": 35.191,
   "delivery": "creeping, slow",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "You slam the stop button.",
   "start": 35.691,
   "end": 36.926,
   "delivery": "fast",
   "speed": 1.06
  },
  {
   "id": "D4",
   "who": "DR",
   "text": "Not yet. You still have a ticket.",
   "start": 37.326,
   "end": 39.638,
   "delivery": "calm, deep",
   "speed": 0.9
  },
  {
   "id": "N11",
   "who": "N",
   "text": "You never bought a ticket. But it's in your hand. One way.",
   "start": 40.038,
   "end": 42.693,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Then the driver looks at you in the mirror... and he doesn't have a face.",
   "start": 43.193,
   "end": 45.824,
   "delivery": "terror, slow",
   "speed": 1.06
  },
  {
   "id": "N13",
   "who": "N",
   "text": "The bus is slowing down. Your stop is coming.",
   "start": 46.424,
   "end": 48.802,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N14",
   "who": "N",
   "text": "Pull the emergency handle. Smash the window. Or sit back down.",
   "start": 49.102,
   "end": 52.444,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N15",
   "who": "N",
   "text": "Comment one, two, or three. The top comment decides part two.",
   "start": 52.744,
   "end": 56.276,
   "delivery": "low, final",
   "speed": 1.06
  }
