{
 "title": "What If Gravity Disappeared for 10 Seconds?",
 "engine": "chatterbox",
 "voice_ref": "kokoro:am_fenrir",
 "tempo": 1.12,
 "lines": [
  {
   "id": "L01",
   "who": "N",
   "text": "Gravity just switched off. You've got ten seconds.",
