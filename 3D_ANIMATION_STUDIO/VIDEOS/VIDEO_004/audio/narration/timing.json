   "end": 22.391,
   "delivery": "countdown",
   "speed": 0.95
  },
  {
   "id": "L10",
   "who": "N",
   "text": "And gravity's back.",
   "start": 23.591,
   "end": 24.56,
   "delivery": "payoff",
   "speed": 1.12
  },
  {
   "id": "L11",
   "who": "M",
   "text": "Okay. I'm never complaining about gravity again.",
