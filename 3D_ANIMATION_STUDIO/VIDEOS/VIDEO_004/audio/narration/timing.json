 "lines": [
  {
   "id": "L01",
   "who": "N",
   "text": "Gravity just switched off. You've got ten seconds.",
   "start": 0.0,
   "end": 2.661,
   "delivery": "hook",
   "speed": 1.12
  },
  {
   "id": "L02",
   "who": "M",
   "text": "Wait. I'm flying?!",
