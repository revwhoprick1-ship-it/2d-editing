 "lines": [
  {
   "id": "N01",
   "who": "C",
   "text": "What if you never stopped? Not for one single second.",
   "start": 0.0,
   "end": 3.074,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N02",
   "who": "C",
   "text": "Hour one. You burned a hundred calories. That's one cookie.",
   "start": 3.274,
   "end": 6.71,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N03",
   "who": "C",
   "text": "Day one. You lost two liters of water. You're a raisin now.",
   "start": 7.01,
   "end": 10.715,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N04",
   "who": "C",
   "text": "Day three. Your wrist files for divorce.",
   "start": 11.015,
   "end": 13.398,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N05",
   "who": "C",
   "text": "Week one. Friction wins. Friction always wins.",
   "start": 13.798,
   "end": 17.312,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N06",
   "who": "C",
   "text": "Plus, after round one, your body forces a cooldown. Science says: no.",
   "start": 17.612,
   "end": 22.643,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N07",
   "who": "C",
   "text": "So you'd just be sitting there. Forever.",
   "start": 22.943,
   "end": 25.142,
   "delivery": "",
   "speed": 1.12
  },
  {
   "id": "N08",
   "who": "C",
   "text": "Then your mom opens the door.",
   "start": 25.742,
   "end": 27.171,
   "delivery": "",
   "speed": 1.12
  }
 ],
