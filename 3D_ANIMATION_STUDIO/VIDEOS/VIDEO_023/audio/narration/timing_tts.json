 "lines": [
  {
   "id": "K01",
   "who": "K",
   "text": "Everyone on Earth turned into zombies. Fast ones. Smart ones.",
   "start": 0.0,
   "end": 3.914,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K02",
   "who": "K",
   "text": "Everyone except me and Tara.",
   "start": 3.914,
   "end": 5.702,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "Z01",
   "who": "Z",
   "text": "We don't want to hurt you. Open the gate.",
   "start": 6.002,
   "end": 8.221,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K03",
   "who": "K",
   "text": "They talk now. And they brought a drone.",
   "start": 8.521,
   "end": 10.806,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "D01",
   "who": "D",
   "text": "Two warm bodies. Aisle seven.",
   "start": 11.006,
   "end": 13.268,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K04",
   "who": "K",
   "text": "The freezer! If we're cold, they can't see us!",
   "start": 13.568,
   "end": 16.438,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "D02",
   "who": "D",
   "text": "One warm body. Freezer.",
   "start": 16.738,
   "end": 18.984,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K05",
   "who": "K",
   "text": "One? Then I saw it. Tara's breath wasn't fogging.",
   "start": 19.384,
   "end": 23.311,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T01",
   "who": "T",
   "text": "Mika... it bit me at the gate.",
   "start": 23.611,
   "end": 25.74,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T02",
   "who": "T",
   "text": "Lock the door behind me.",
   "start": 25.94,
   "end": 27.266,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T03",
   "who": "T",
   "text": "Hey! Over here!",
   "start": 27.566,
   "end": 29.038,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K06",
   "who": "K",
   "text": "She bought me ten seconds.",
   "start": 29.538,
   "end": 31.096,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T04",
   "who": "T",
   "text": "Mika. It's me. They're gone. Open the door.",
   "start": 31.696,
   "end": 35.184,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K07",
   "who": "K",
   "text": "Her breath doesn't fog the glass.",
   "start": 35.584,
   "end": 37.53,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K08",
   "who": "K",
   "text": "Open, stay, or back door? Comment now.",
   "start": 37.73,
   "end": 41.253,
   "delivery": "",
   "speed": 1.08
  }
