 "lines": [
  {
   "id": "K01",
   "who": "K",
   "text": "Everyone on Earth turned into zombies. Fast ones. Smart ones.",
   "start": 0.25,
   "end": 4.164,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K02",
   "who": "K",
   "text": "Everyone except me and Tara.",
   "start": 4.164,
   "end": 5.952,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "Z01",
   "who": "Z",
   "text": "We don't want to hurt you. Open the gate.",
   "start": 7.432,
   "end": 9.969,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K03",
   "who": "K",
   "text": "They talk now. And they brought a drone.",
   "start": 10.149,
   "end": 12.434,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "D01",
   "who": "D",
   "text": "Two warm bodies. Aisle seven.",
   "start": 13.454,
   "end": 16.136,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K04",
   "who": "K",
   "text": "The freezer! If we're cold, they can't see us!",
   "start": 16.316,
   "end": 19.185,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "D02",
   "who": "D",
   "text": "One warm body. Freezer.",
   "start": 20.965,
   "end": 23.632,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K05",
   "who": "K",
   "text": "One? Then I saw it. Tara's breath wasn't fogging.",
   "start": 23.872,
   "end": 27.799,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T01",
   "who": "T",
   "text": "Mika... it bit me at the gate.",
   "start": 27.979,
   "end": 30.108,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T02",
   "who": "T",
   "text": "Lock the door behind me.",
   "start": 30.228,
   "end": 31.554,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T03",
   "who": "T",
   "text": "Hey! Over here!",
   "start": 32.734,
   "end": 34.506,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K06",
   "who": "K",
   "text": "She bought me ten seconds.",
   "start": 36.406,
   "end": 37.964,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "T04",
   "who": "T",
   "text": "Mika. It's me. They're gone. Open the door.",
   "start": 39.424,
   "end": 43.212,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K07",
   "who": "K",
   "text": "Her breath doesn't fog the glass.",
   "start": 43.452,
   "end": 45.398,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "K08",
   "who": "K",
   "text": "Open, stay, or back door? Comment now.",
   "start": 45.518,
   "end": 48.505,
   "delivery": "",
   "speed": 1.08
  }
