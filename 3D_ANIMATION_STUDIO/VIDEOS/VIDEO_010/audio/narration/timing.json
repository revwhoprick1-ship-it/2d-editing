{
 "voice": "chatterbox+kokoro:am_fenrir",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "You chose the window.",
   "start": 0.0,
   "end": 0.944,
   "delivery": "sudden, low",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "One swing. The glass explodes... and the fog pours in.",
   "start": 1.244,
   "end": 4.306,
   "delivery": "fast, tense",
   "speed": 1.06
  },
  {
   "id": "D1",
   "who": "DR",
   "text": "That's not an exit.",
   "start": 4.606,
   "end": 5.565,
   "delivery": "calm, deep, slow",
   "speed": 0.9
  },
  {
   "id": "N03",
   "who": "N",
   "text": "You don't care. You climb through and drop onto the road.",
   "start": 5.965,
   "end": 8.78,
   "delivery": "fast",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Behind you, the bus doesn't stop. Its lights just fade into the fog.",
   "start": 9.08,
   "end": 12.577,
   "delivery": "creeping",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "And then you see them. The passengers. Standing in the road.",
   "start": 12.977,
   "end": 15.724,
   "delivery": "dread",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "They've stopped waving.",
   "start": 16.024,
   "end": 17.05,
   "delivery": "whisper, scary",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "Every head tilts at the same time. And they start walking toward you.",
   "start": 17.65,
   "end": 21.157,
   "delivery": "dread, faster",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "You run. You don't look back. Until you see a bus stop.",
   "start": 21.457,
   "end": 24.189,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "Route thirteen. And on the glass, there's a poster. Missing. With your face on it.",
   "start": 24.589,
   "end": 28.433,
   "delivery": "creeping, slow",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "Your phone buzzes. Forty-seven missed calls from Mom.",
   "start": 28.833,
   "end": 31.355,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "N11",
   "who": "N",
   "text": "And the date... is one year from tonight.",
   "start": 31.655,
   "end": 33.869,
   "delivery": "dread, slow",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Then two headlights come through the fog. The doors open.",
   "start": 34.469,
   "end": 37.199,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "D2",
   "who": "DR",
   "text": "You missed your stop.",
   "start": 37.599,
   "end": 38.795,
   "delivery": "calm, deep",
   "speed": 0.9
  },
  {
   "id": "N13",
   "who": "N",
   "text": "Every passenger is back in their seat, waving at you.",
   "start": 39.195,
   "end": 41.577,
   "delivery": "creeping",
   "speed": 1.06
  },
  {
   "id": "N14",
   "who": "N",
   "text": "And someone is sitting in your seat... wearing your face.",
   "start": 41.877,
   "end": 44.237,
   "delivery": "terror, slow",
   "speed": 1.06
  },
  {
   "id": "N15",
   "who": "N",
   "text": "Get back on the bus. Run into the fog. Or call Mom back.",
   "start": 44.837,
   "end": 47.915,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N16",
   "who": "N",
   "text": "Comment one, two, or three. Part three is up to you.",
   "start": 48.215,
   "end": 51.276,
   "delivery": "low, final",
   "speed": 1.06
  }
 ],
