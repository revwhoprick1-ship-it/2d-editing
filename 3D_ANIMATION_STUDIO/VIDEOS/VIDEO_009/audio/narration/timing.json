{
 "voice": "chatterbox+kokoro:am_fenrir",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "They don't break down doors anymore.",
   "start": 0.0,
   "end": 1.565,
   "delivery": "low, ominous",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "They knock.",
   "start": 2.065,
   "end": 3.102,
   "delivery": "whisper, dread",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Three days ago, the infected were slow. Stupid. Easy to outrun.",
   "start": 4.502,
   "end": 8.425,
   "delivery": "calm, low",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Now they run. They set traps. And yesterday... one of them used a phone.",
   "start": 8.725,
   "end": 12.231,
   "delivery": "creeping",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "You're barricaded in room two-oh-four with your three best friends.",
   "start": 12.631,
   "end": 15.744,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "N17",
   "who": "N",
   "text": "Bob. Lawrence. And Justin.",
   "start": 16.044,
   "end": 17.578,
   "delivery": "quick",
   "speed": 1.06
  },
  {
   "id": "B1",
   "who": "BOB",
   "text": "Nobody answer it.",
   "start": 17.878,
   "end": 18.924,
   "delivery": "calm, whisper",
   "speed": 1.06
  },
  {
   "id": "J1",
   "who": "JUS",
   "text": "Obviously nobody's answering it!",
   "start": 19.124,
   "end": 20.394,
   "delivery": "panicked whisper",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "Then a voice comes through the door. And it sounds exactly like your teacher.",
   "start": 20.794,
   "end": 24.571,
   "delivery": "dread",
   "speed": 1.06
  },
  {
   "id": "Z1",
   "who": "ZT",
   "text": "Class... it's safe now. You can open the door.",
   "start": 24.871,
   "end": 27.658,
   "delivery": "calm, gentle, wrong",
   "speed": 0.88
  },
  {
   "id": "L1",
   "who": "LAW",
   "text": "Mr. Peterson got bitten on Monday.",
   "start": 28.058,
   "end": 30.077,
   "delivery": "shaky whisper",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "Lawrence checks the window. Three floors down, the courtyard is full.",
   "start": 30.477,
   "end": 33.839,
   "delivery": "tense",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "And none of them are moving. They're all looking up. At this window.",
   "start": 34.139,
   "end": 37.134,
   "delivery": "dread, slow",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "Then Justin's phone lights up. A text... from Mr. Peterson.",
   "start": 37.634,
   "end": 40.627,
   "delivery": "creeping",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "I know you're in two-oh-four.",
   "start": 40.927,
   "end": 42.297,
   "delivery": "whisper, scary",
   "speed": 1.06
  },
  {
   "id": "N11",
   "who": "N",
   "text": "And the knocking stops.",
   "start": 42.897,
   "end": 44.098,
   "delivery": "flat",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Something starts scratching inside the air vent. Right above you.",
   "start": 45.098,
   "end": 48.208,
   "delivery": "terror",
   "speed": 1.06
  },
  {
   "id": "B2",
   "who": "BOB",
   "text": "Guys. The vent.",
   "start": 48.508,
   "end": 49.938,
   "delivery": "calm but scared",
   "speed": 1.06
  },
  {
   "id": "N13",
   "who": "N",
   "text": "They were never coming through the door. The knocking was to keep you looking at it.",
   "start": 50.238,
   "end": 53.774,
   "delivery": "dread, fast",
   "speed": 1.06
  },
  {
   "id": "N14",
   "who": "N",
   "text": "You've got ten seconds.",
   "start": 54.174,
   "end": 55.431,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N15",
   "who": "N",
   "text": "Run for the hallway. Climb onto the roof. Or hide in the supply closet.",
   "start": 55.731,
   "end": 59.179,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N16",
   "who": "N",
   "text": "Comment one, two, or three. Choose wrong... and someone doesn't make it to part two.",
   "start": 59.479,
   "end": 63.729,
   "delivery": "low, final",
   "speed": 1.06
  }
 ],
