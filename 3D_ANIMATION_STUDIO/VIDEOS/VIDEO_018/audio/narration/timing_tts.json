 "lines": [
  {
   "id": "A01",
   "who": "A",
   "text": "Two hundred and eleven. Two hundred and twelve. Two hundred and thirteen.",
   "start": 0.0,
   "end": 3.889,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A02",
   "who": "A",
   "text": "This plane only has two hundred and twelve seats.",
   "start": 4.189,
   "end": 6.618,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L01",
   "who": "L",
   "text": "So somebody's sitting on somebody's lap?",
   "start": 7.018,
   "end": 9.113,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Every seat is full. Nobody's standing.",
   "start": 9.313,
   "end": 12.228,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Then who's the extra passenger?",
   "start": 12.428,
   "end": 13.99,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M02",
   "who": "M",
   "text": "The man in twenty-two C. He hasn't moved since takeoff.",
   "start": 14.59,
   "end": 18.088,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B02",
   "who": "B",
   "text": "He's not breathing. Look at his chest.",
   "start": 18.288,
   "end": 20.333,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L02",
   "who": "L",
   "text": "And that kid has been drawing us. For three hours.",
   "start": 20.933,
   "end": 23.262,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "G01",
   "who": "G",
   "text": "I'm drawing everyone on the plane.",
   "start": 23.562,
   "end": 25.256,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B03",
   "who": "B",
   "text": "She drew someone sitting between us. With no face.",
   "start": 25.756,
   "end": 28.325,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A03",
   "who": "A",
   "text": "Two hundred and fourteen.",
   "start": 28.925,
   "end": 30.199,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Now there's two of them.",
   "start": 30.599,
   "end": 31.793,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B04",
   "who": "B",
   "text": "Wait. I booked two seats. You and me.",
   "start": 32.293,
   "end": 34.717,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M04",
   "who": "M",
   "text": "Then Lawrence... where's your ticket?",
   "start": 35.017,
   "end": 37.165,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L03",
   "who": "L",
   "text": "Guys. Come on. I've always been here.",
   "start": 37.765,
   "end": 40.054,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "X01",
   "who": "X",
   "text": "He's lying.",
   "start": 40.654,
   "end": 41.31,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "G02",
   "who": "G",
   "text": "One of us isn't real. Pick wrong... and you become the extra passenger.",
   "start": 41.91,
   "end": 46.317,
   "delivery": "",
   "speed": 1.08
  }
