 "lines": [
  {
   "id": "A01",
   "who": "A",
   "text": "Two hundred and eleven. Two hundred and twelve. Two hundred and thirteen.",
   "start": 0.0,
   "end": 3.889,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A02",
   "who": "A",
   "text": "This plane only has two hundred and twelve seats.",
   "start": 4.189,
   "end": 6.618,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L01",
   "who": "L",
   "text": "So somebody's sitting on somebody's lap?",
   "start": 7.018,
   "end": 9.113,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Every seat is full. Nobody's standing.",
   "start": 9.313,
   "end": 12.228,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Then who's the extra passenger?",
   "start": 12.428,
   "end": 13.99,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M02",
   "who": "M",
   "text": "The man in twenty-two C. He hasn't moved since takeoff.",
   "start": 15.49,
   "end": 18.988,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B02",
   "who": "B",
   "text": "He's not breathing. Look at his chest.",
   "start": 19.188,
   "end": 21.233,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L02",
   "who": "L",
   "text": "And that kid has been drawing us. For three hours.",
   "start": 21.833,
   "end": 24.162,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "G01",
   "who": "G",
   "text": "I'm drawing everyone on the plane.",
   "start": 25.062,
   "end": 26.756,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B03",
   "who": "B",
   "text": "She drew someone sitting between us. With no face.",
   "start": 28.156,
   "end": 30.725,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A03",
   "who": "A",
   "text": "Two hundred and fourteen.",
   "start": 33.325,
   "end": 34.599,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Now there's two of them.",
   "start": 34.999,
   "end": 36.193,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B04",
   "who": "B",
   "text": "Wait. I booked two seats. You and me.",
   "start": 37.193,
   "end": 39.617,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M04",
   "who": "M",
   "text": "Then Lawrence... where's your ticket?",
   "start": 39.917,
   "end": 42.065,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L03",
   "who": "L",
   "text": "Guys. Come on. I've always been here.",
   "start": 43.065,
   "end": 45.354,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "X01",
   "who": "X",
   "text": "He's lying.",
   "start": 46.654,
   "end": 47.31,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "G02",
   "who": "G",
   "text": "One of us isn't real. Pick wrong... and you become the extra passenger.",
   "start": 48.41,
   "end": 52.817,
   "delivery": "",
   "speed": 1.08
  }
