{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Grandma has one rule. Never touch the vase.",
   "start": 0.0,
   "end": 5.046,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "I just broke it.",
   "start": 5.146,
   "end": 6.655,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Something black crawled out of the pieces... and slid under my bed.",
   "start": 7.155,
   "end": 12.285,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Inside the vase, there was a note. In Grandma's handwriting.",
   "start": 12.685,
   "end": 16.911,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "If it breaks. Don't blink when it's in the room. Don't answer when I call you. Count the pieces.",
   "start": 17.111,
   "end": 24.203,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "Twenty-four pieces. I counted twenty-three.",
   "start": 24.603,
   "end": 28.236,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "The face piece was gone.",
   "start": 28.536,
   "end": 30.499,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O01",
   "who": "O",
   "text": "Sweetie? Dinner's ready!",
   "start": 30.999,
   "end": 32.878,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Mom's car wasn't in the driveway.",
   "start": 33.278,
   "end": 36.074,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "G01",
   "who": "G",
   "text": "Did it break? Listen to me. Don't let it see you blink.",
   "start": 36.474,
   "end": 40.417,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O02",
   "who": "O",
   "text": "Who are you talking to, sweetie?",
   "start": 40.717,
   "end": 42.462,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "My eyes started burning.",
   "start": 42.962,
   "end": 45.081,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Don't blink. Don't blink. Don't blink.",
   "start": 45.281,
   "end": 48.892,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Give me my face.",
   "start": 49.492,
   "end": 50.817,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "That's when I noticed what was in my hand.",
   "start": 51.217,
   "end": 53.938,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N11",
   "who": "N",
   "text": "So what do I do? One, give it the face. Two, smash it. Three, run to Grandma's house.",
   "start": 54.438,
   "end": 62.605,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Comment fast. It's getting closer.",
   "start": 62.905,
   "end": 65.92,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X02",
   "who": "X",
   "text": "Blink.",
   "start": 66.32,
   "end": 66.923,
   "delivery": "",
   "speed": 1.06
  }
