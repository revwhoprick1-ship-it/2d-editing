{
 "voice": "qwen3-tts",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Grandma has one rule. Never touch the vase.",
   "start": 0.0,
   "end": 3.981,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "I just broke it.",
   "start": 4.041,
   "end": 5.454,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "Something black crawled out of the pieces... and slid under my bed.",
   "start": 6.354,
   "end": 11.484,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Inside the vase, there was a note. In Grandma's handwriting.",
   "start": 11.724,
   "end": 15.949,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "If it breaks. Don't blink when it's in the room. Don't answer when I call you. Count the pieces.",
   "start": 16.069,
   "end": 23.162,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "Twenty-four pieces. I counted twenty-three.",
   "start": 23.402,
   "end": 27.035,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "The face piece was gone.",
   "start": 27.215,
   "end": 29.178,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O01",
   "who": "O",
   "text": "Sweetie? Dinner's ready!",
   "start": 29.478,
   "end": 31.657,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Mom's car wasn't in the driveway.",
   "start": 31.897,
   "end": 34.693,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "G01",
   "who": "G",
   "text": "Did it break? Listen to me. Don't let it see you blink.",
   "start": 35.533,
   "end": 39.776,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "O02",
   "who": "O",
   "text": "Who are you talking to, sweetie?",
   "start": 40.356,
   "end": 42.4,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "My eyes started burning.",
   "start": 42.7,
   "end": 44.82,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Don't blink. Don't blink. Don't blink.",
   "start": 44.94,
   "end": 48.551,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Give me my face.",
   "start": 49.611,
   "end": 51.365,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "That's when I noticed what was in my hand.",
   "start": 51.905,
   "end": 54.626,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N11",
   "who": "N",
   "text": "So what do I do? One, give it the face. Two, smash it. Three, run to Grandma's house.",
   "start": 54.926,
   "end": 63.093,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Comment fast. It's getting closer.",
   "start": 63.273,
   "end": 66.288,
   "delivery": "",
   "speed": 1.06
  },
  {
   "id": "X02",
   "who": "X",
   "text": "Blink.",
   "start": 67.028,
   "end": 68.062,
   "delivery": "",
   "speed": 1.06
  }
 ],
