 "lines": [
  {
   "id": "L01",
   "who": "N",
   "text": "Your toilet just quit its job.",
   "start": 0.0,
   "end": 1.356,
   "delivery": "hook",
   "speed": 1.12
  },
  {
   "id": "L02",
   "who": "M",
   "text": "Wait... what?",
   "start": 1.756,
   "end": 2.315,
   "delivery": "confused",
   "speed": 1.12
  },
  {
   "id": "L03",
   "who": "N",
   "text": "Okay. Maybe it's just tired.",
   "start": 3.115,
   "end": 4.945,
   "delivery": "reassuring",
   "speed": 1.12
  },
  {
   "id": "L04",
   "who": "M",
   "text": "Bro, seriously?!",
   "start": 5.295,
   "end": 6.427,
   "delivery": "outraged",
   "speed": 1.12
  },
  {
   "id": "L05",
   "who": "N",
   "text": "Now it flushes itself. Out of pure spite.",
   "start": 7.027,
   "end": 9.368,
   "delivery": "comic",
   "speed": 1.12
  },
  {
   "id": "L06",
   "who": "N",
   "text": "And it's not just yours. Every toilet on Earth is fighting back.",
   "start": 10.768,
   "end": 14.578,
   "delivery": "epic",
   "speed": 1.12
  },
  {
   "id": "L07",
   "who": "N",
   "text": "They chase you. They block the exits. They fire toilet paper like missiles.",
   "start": 14.728,
   "end": 18.136,
   "delivery": "fast",
   "speed": 1.12
  },
  {
   "id": "L08",
   "who": "N",
   "text": "So he hides in the one room they'd never check.",
   "start": 18.936,
   "end": 20.818,
   "delivery": "sly",
   "speed": 1.12
  },
  {
   "id": "L09",
   "who": "N",
   "text": "The bathroom.",
   "start": 21.618,
   "end": 22.208,
   "delivery": "deadpan",
   "speed": 1.12
  },
  {
   "id": "L10",
   "who": "M",
   "text": "I'm never using a toilet again!",
   "start": 26.408,
   "end": 27.625,
   "delivery": "exhausted",
   "speed": 1.12
  },
  {
   "id": "L11",
   "who": "N",
   "text": "Unfortunately, the bathtub disagrees.",
   "start": 28.625,
   "end": 31.161,
   "delivery": "ominous",
   "speed": 1.12
  }
