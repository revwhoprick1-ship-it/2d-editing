{
 "voice": "chatterbox+kokoro:am_fenrir",
 "sample_rate": 24000,
 "lines": [
  {
   "id": "N01",
   "who": "N",
   "text": "Three seconds left in the championship. Down by two.",
   "start": 0.0,
   "end": 2.647,
   "delivery": "tense, low",
   "speed": 1.06
  },
  {
   "id": "N02",
   "who": "N",
   "text": "And the best player in this gym is sitting on the bench.",
   "start": 2.947,
   "end": 5.546,
   "delivery": "dramatic",
   "speed": 1.06
  },
  {
   "id": "N03",
   "who": "N",
   "text": "That's you.",
   "start": 5.946,
   "end": 6.613,
   "delivery": "quiet, heavy",
   "speed": 1.06
  },
  {
   "id": "N04",
   "who": "N",
   "text": "Two months ago, you showed up to tryouts in old shoes and a borrowed jersey.",
   "start": 7.813,
   "end": 11.605,
   "delivery": "storyteller",
   "speed": 1.06
  },
  {
   "id": "T1",
   "who": "TY",
   "text": "Nice shoes. Did your grandpa lend you those?",
   "start": 11.905,
   "end": 13.798,
   "delivery": "mocking, laughing",
   "speed": 1.06
  },
  {
   "id": "N05",
   "who": "N",
   "text": "The whole team laughed. Coach laughed the loudest.",
   "start": 14.098,
   "end": 17.005,
   "delivery": "flat",
   "speed": 1.06
  },
  {
   "id": "C1",
   "who": "CO",
   "text": "Kid, you're here to fill water bottles.",
   "start": 17.305,
   "end": 19.106,
   "delivery": "gruff, dismissive",
   "speed": 1.06
  },
  {
   "id": "N06",
   "who": "N",
   "text": "So you filled water bottles. And every night, when the gym was empty... you practiced.",
   "start": 19.506,
   "end": 23.242,
   "delivery": "building",
   "speed": 1.06
  },
  {
   "id": "N07",
   "who": "N",
   "text": "Five hundred shots a night. Left hand. Right hand. Eyes closed.",
   "start": 23.543,
   "end": 27.385,
   "delivery": "rhythmic, intense",
   "speed": 1.06
  },
  {
   "id": "N08",
   "who": "N",
   "text": "Then one night, the janitor saw you hit twenty threes in a row. And he pressed record.",
   "start": 27.685,
   "end": 31.622,
   "delivery": "excited, low",
   "speed": 1.06
  },
  {
   "id": "N09",
   "who": "N",
   "text": "That video now has two million views. Everyone in this gym has seen it.",
   "start": 31.922,
   "end": 36.161,
   "delivery": "building",
   "speed": 1.06
  },
  {
   "id": "N10",
   "who": "N",
   "text": "Everyone... except Coach.",
   "start": 36.461,
   "end": 38.029,
   "delivery": "dry",
   "speed": 1.06
  },
  {
   "id": "T2",
   "who": "TY",
   "text": "Stay on the bench, water boy.",
   "start": 38.429,
   "end": 39.543,
   "delivery": "mocking",
   "speed": 1.06
  },
  {
   "id": "N11",
   "who": "N",
   "text": "Then Tyler fouls out. And the crowd starts chanting a number. Your number. Twenty-three.",
   "start": 39.943,
   "end": 44.348,
   "delivery": "rising, excited",
   "speed": 1.06
  },
  {
   "id": "N12",
   "who": "N",
   "text": "Coach finally turns around. And looks right at you.",
   "start": 44.748,
   "end": 46.683,
   "delivery": "slow, dramatic",
   "speed": 1.06
  },
  {
   "id": "C2",
   "who": "CO",
   "text": "You. Get in.",
   "start": 47.083,
   "end": 48.241,
   "delivery": "gruff, reluctant",
   "speed": 1.06
  },
  {
   "id": "N13",
   "who": "N",
   "text": "Three seconds. One play. The whole school is watching.",
   "start": 48.741,
   "end": 51.238,
   "delivery": "intense",
   "speed": 1.06
  },
  {
   "id": "N14",
   "who": "N",
   "text": "Take the three for the win. Drive in for the tie. Or pass, and let someone else take the shot.",
   "start": 51.538,
   "end": 56.406,
   "delivery": "urgent",
   "speed": 1.06
  },
  {
   "id": "N15",
   "who": "N",
   "text": "Comment one, two, or three. Part two, you take the shot we pick.",
   "start": 56.706,
   "end": 60.374,
   "delivery": "low, final",
   "speed": 1.06
  }
 ],
