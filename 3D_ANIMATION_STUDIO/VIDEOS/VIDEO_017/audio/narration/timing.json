 "lines": [
  {
   "id": "A01",
   "who": "A",
   "text": "The seatbelt sign is on. Nobody unbuckles. For any reason.",
   "start": 0.0,
   "end": 4.057,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L01",
   "who": "L",
   "text": "Any reason? Bro, I drank four Sprites.",
   "start": 4.357,
   "end": 7.204,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Lawrence. Don't.",
   "start": 7.404,
   "end": 8.558,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Guys... look at the map. We've been circling the same spot for six hours.",
   "start": 9.758,
   "end": 13.67,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M02",
   "who": "M",
   "text": "And why is row fourteen empty... with every seatbelt still buckled?",
   "start": 13.97,
   "end": 17.47,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A02",
   "who": "A",
   "text": "Something to drink?",
   "start": 19.37,
   "end": 20.219,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Bob. Don't look at her feet.",
   "start": 20.719,
   "end": 22.609,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B02",
   "who": "B",
   "text": "Why not?",
   "start": 23.609,
   "end": 24.198,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A03",
   "who": "A",
   "text": "You looked.",
   "start": 25.198,
   "end": 25.754,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L02",
   "who": "L",
   "text": "Okay. I'm not peeing in a bottle. Ten seconds. I'll be quick.",
   "start": 27.654,
   "end": 31.276,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M04",
   "who": "M",
   "text": "Lawrence, no!",
   "start": 31.476,
   "end": 32.744,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L03",
   "who": "L",
   "text": "Why is everyone looking at me?",
   "start": 35.444,
   "end": 36.866,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M05",
   "who": "M",
   "text": "Lawrence, get down!",
   "start": 38.666,
   "end": 40.395,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B03",
   "who": "B",
   "text": "It folded him. It folded him into the bin!",
   "start": 42.995,
   "end": 45.341,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "C01",
   "who": "C",
   "text": "This is your captain. The passenger out of his seat... has been stowed.",
   "start": 45.741,
   "end": 49.371,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B04",
   "who": "B",
   "text": "Every bin is moving.",
   "start": 50.271,
   "end": 51.4,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M06",
   "who": "M",
   "text": "Bob. Whatever happens, keep your belt on.",
   "start": 53.8,
   "end": 56.685,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B05",
   "who": "B",
   "text": "My belt... it's broken!",
   "start": 57.285,
   "end": 58.855,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M07",
   "who": "M",
   "text": "Hold my arm! Don't let go!",
   "start": 59.655,
   "end": 61.368,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Bro... it's just ten seconds.",
   "start": 63.168,
   "end": 65.181,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A04",
   "who": "A",
   "text": "We have landed. You may now unbuckle.",
   "start": 66.981,
   "end": 69.112,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B06",
   "who": "B",
   "text": "We made it! We actually made it!",
   "start": 69.512,
   "end": 71.213,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M08",
   "who": "M",
   "text": "Bob... look out the window.",
   "start": 71.613,
   "end": 73.174,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M09",
   "who": "M",
   "text": "We never landed.",
   "start": 73.774,
   "end": 74.636,
   "delivery": "",
   "speed": 1.08
  }
