 "lines": [
  {
   "id": "A01",
   "who": "A",
   "text": "The seatbelt sign is on. Nobody unbuckles. For any reason.",
   "start": 0.0,
   "end": 4.057,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L01",
   "who": "L",
   "text": "Any reason? Bro, I drank four Sprites.",
   "start": 4.357,
   "end": 7.204,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M01",
   "who": "M",
   "text": "Lawrence. Don't.",
   "start": 7.404,
   "end": 8.558,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B01",
   "who": "B",
   "text": "Guys... look at the map. We've been circling the same spot for six hours.",
   "start": 8.958,
   "end": 12.869,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M02",
   "who": "M",
   "text": "And why is row fourteen empty... with every seatbelt still buckled?",
   "start": 13.169,
   "end": 16.67,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A02",
   "who": "A",
   "text": "Something to drink?",
   "start": 17.17,
   "end": 18.018,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M03",
   "who": "M",
   "text": "Bob. Don't look at her feet.",
   "start": 18.518,
   "end": 20.409,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B02",
   "who": "B",
   "text": "Why not?",
   "start": 20.709,
   "end": 21.298,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A03",
   "who": "A",
   "text": "You looked.",
   "start": 21.898,
   "end": 22.454,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L02",
   "who": "L",
   "text": "Okay. I'm not peeing in a bottle. Ten seconds. I'll be quick.",
   "start": 23.054,
   "end": 26.676,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M04",
   "who": "M",
   "text": "Lawrence, no!",
   "start": 26.876,
   "end": 28.144,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "L03",
   "who": "L",
   "text": "Why is everyone looking at me?",
   "start": 28.944,
   "end": 30.366,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M05",
   "who": "M",
   "text": "Lawrence, get down!",
   "start": 31.166,
   "end": 32.895,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B03",
   "who": "B",
   "text": "It folded him. It folded him into the bin!",
   "start": 33.495,
   "end": 35.841,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "C01",
   "who": "C",
   "text": "This is your captain. The passenger out of his seat... has been stowed.",
   "start": 36.241,
   "end": 39.871,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B04",
   "who": "B",
   "text": "Every bin is moving.",
   "start": 40.471,
   "end": 41.6,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M06",
   "who": "M",
   "text": "Bob. Whatever happens, keep your belt on.",
   "start": 42.2,
   "end": 45.085,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B05",
   "who": "B",
   "text": "My belt... it's broken!",
   "start": 45.685,
   "end": 47.255,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M07",
   "who": "M",
   "text": "Hold my arm! Don't let go!",
   "start": 47.555,
   "end": 49.268,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "X01",
   "who": "X",
   "text": "Bro... it's just ten seconds.",
   "start": 49.868,
   "end": 51.881,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "A04",
   "who": "A",
   "text": "We have landed. You may now unbuckle.",
   "start": 52.481,
   "end": 54.612,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "B06",
   "who": "B",
   "text": "We made it! We actually made it!",
   "start": 55.012,
   "end": 56.713,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M08",
   "who": "M",
   "text": "Bob... look out the window.",
   "start": 57.113,
   "end": 58.674,
   "delivery": "",
   "speed": 1.08
  },
  {
   "id": "M09",
   "who": "M",
   "text": "We never landed.",
   "start": 59.274,
   "end": 60.136,
   "delivery": "",
   "speed": 1.08
  }
